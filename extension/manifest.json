{
  "manifest_version": 3,
  "name": "AVIIN ATS — Import Candidates",
  "version": "1.0.0",
  "description": "Import a candidate from a LinkedIn profile into AVIIN ATS with one click.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://ats.aviintech.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Import to AVIIN ATS"
  }
}
